
.product-details-page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #172033;
  padding: 24px;
}

.details-header {
  max-width: 1100px;
  margin: 0 auto 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.details-brand {
  color: #147d64;
  font-size: 1.5rem;
  font-weight: 800;
  text-decoration: none;
}

.details-back {
  border: 1px solid #d9e1ea;
  border-radius: 10px;
  background: #fff;
  color: #243047;
  padding: 11px 16px;
  cursor: pointer;
}

.details-layout {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 32px;
  align-items: start;
}

.details-image {
  min-height: 340px;
  border-radius: 18px;
  background: #e9eef5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.details-image img {
  display: block;
  width: 100%;
  max-height: 560px;
  object-fit: contain;
}

.details-info {
  padding: 28px;
  border: 1px solid #e5eaf1;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 8px 30px rgb(20 35 60 / 5%);
}

.details-category {
  color: #147d64;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: capitalize;
}

.details-info h1 {
  margin: 10px 0 14px;
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  line-height: 1.2;
}

.details-price {
  margin: 0 0 12px;
  color: #147d64;
  font-size: 1.8rem;
  font-weight: 800;
}

.details-location,
.details-description,
.details-seller,
.details-stock,
.details-note {
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.details-divider {
  height: 1px;
  margin: 22px 0;
  background: #e8edf3;
}

.details-info h2 {
  margin: 0 0 10px;
  font-size: 1.1rem;
}

.details-description {
  white-space: pre-wrap;
  color: #536075;
}

.details-seller {
  font-weight: 700;
}

.details-stock {
  color: #147d64;
}

.details-note {
  padding: 12px;
  border-radius: 10px;
  background: #f0f8f5;
  color: #42675d;
  font-size: 0.9rem;
}

.details-message {
  max-width: 600px;
  margin: 80px auto;
  padding: 32px;
  border-radius: 16px;
  background: #fff;
  text-align: center;
}

.details-message button {
  border: 0;
  border-radius: 10px;
  background: #147d64;
  color: #fff;
  padding: 12px 18px;
  cursor: pointer;
}

@media (max-width: 720px) {
  .product-details-page {
    padding: 16px;
  }

  .details-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .details-layout {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .details-image {
    min-height: 240px;
  }

  .details-info {
    padding: 20px;
  }
}
