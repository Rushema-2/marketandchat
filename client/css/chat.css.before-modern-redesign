}

.password-section h3 {
    margin: 0 0 4px 0;

    color: #111b21;

    font-size: 16px;
    font-weight: 500;
}

.password-section label {
    display: flex;
    flex-direction: column;

    gap: 7px;

    color: #54656f;

    font-size: 14px;
}

.password-section input {
    width: 100%;
    box-sizing: border-box;

    padding: 12px;

    border: 1px solid #d1d7db;
    border-radius: 6px;

    font-size: 15px;

    outline: none;
}

.password-section input:focus {
    border-color: #008069;
}

#changePasswordBtn {
    padding: 12px 18px;

    border: none;
    border-radius: 6px;

    background: #008069;
    color: #ffffff;

    font-size: 15px;

    cursor: pointer;
}

#changePasswordBtn:hover {
    background: #006f5b;
}
