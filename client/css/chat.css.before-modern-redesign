#saveAccountBtn {
    padding: 12px 18px;

    border: none;
    border-radius: 6px;

    background: #008069;
    color: #ffffff;

    font-size: 15px;

    cursor: pointer;
}

#saveAccountBtn:hover {
    background: #006f5b;
}

.password-section {
