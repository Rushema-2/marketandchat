    flex-direction: column;

    gap: 18px;

    padding: 28px 20px;

    overflow-y: auto;
}

.account-panel-body label {
    display: flex;
    flex-direction: column;

    gap: 7px;

    color: #54656f;

    font-size: 14px;
}

.account-panel-body input {
    width: 100%;
