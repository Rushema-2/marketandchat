* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    color: #1f2937;
}

.orders-header {
    background: #075e54;
    color: white;
    padding: 24px clamp(16px, 5vw, 64px);
}

.back-link {
    display: inline-block;
    color: white;
    text-decoration: none;
    margin-bottom: 18px;
    font-weight: 600;
}

.back-link:hover {
    text-decoration: underline;
}

.orders-header h1 {
    margin: 0 0 8px;
    font-size: clamp(26px, 4vw, 36px);
}

.orders-header p {
    margin: 0;
    color: #e0f2f1;
}

.orders-main {
    width: min(100% - 32px, 1000px);
    margin: 28px auto;
}

.orders-message {
    padding: 18px;
    margin-bottom: 16px;
    background: white;
    border-radius: 10px;
    color: #4b5563;
}

.orders-message.error {
    color: #b91c1c;
}

.orders-container {
    display: grid;
    gap: 18px;
}

.order-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 4%);
}

.order-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid #eee;
}

.order-card-header h2 {
    margin: 0 0 6px;
    font-size: 19px;
}

.order-date {
    color: #6b7280;
    font-size: 13px;
}

.order-id {
    color: #6b7280;
    font-size: 12px;
    overflow-wrap: anywhere;
    margin-top: 5px;
}

.order-product {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    align-items: center;
}

.order-product-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 8px;
    background: #f3f4f6;
    flex-shrink: 0;
}

.order-product-details h3 {
    margin: 0 0 8px;
    font-size: 17px;
}

.order-product-details p {
    margin: 5px 0;
    color: #4b5563;
    font-size: 14px;
}

.order-financials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
}

.order-financial-item span {
    display: block;
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 5px;
}

.order-financial-item strong {
    font-size: 16px;
    overflow-wrap: anywhere;
}

.order-statuses {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 12px;
    font-weight: 700;
    background: #f3f4f6;
    color: #374151;
}

.status-successful,
.status-completed {
    background: #dcfce7;
    color: #166534;
}

.status-paid,
.status-processing {
    background: #dbeafe;
    color: #1d4ed8;
}

.status-pending {
    background: #fef3c7;
    color: #92400e;
}

.status-failed,
.status-cancelled,
.status-refunded {
    background: #fee2e2;
    color: #991b1b;
}

.status-expired,
.status-hidden {
    background: #e5e7eb;
    color: #374151;
}

.order-seller {
    margin-top: 14px;
    font-size: 14px;
    color: #4b5563;
}

@media (max-width: 520px) {
    .orders-main {
        width: calc(100% - 20px);
        margin: 16px auto;
    }

    .order-card {
        padding: 14px;
    }

    .order-product {
        align-items: flex-start;
        gap: 12px;
    }

    .order-product-image {
        width: 76px;
        height: 76px;
    }

    .order-financials {
        grid-template-columns: 1fr;
    }
}

/* Visual polish */
.order-card {
    padding: 22px;
    transition: box-shadow 0.2s ease;
}

.order-card:hover {
    box-shadow: 0 6px 18px rgb(0 0 0 / 8%);
}

.order-product-details {
    min-width: 0;
    flex: 1;
}

.order-product-details p {
    line-height: 1.5;
}

.order-financials {
    gap: 16px;
    padding: 18px 0;
}

.order-financial-item {
    min-width: 0;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #edf0f2;
    border-radius: 10px;
}

.order-financial-item span {
    line-height: 1.4;
}

.order-financial-item strong {
    display: block;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.order-statuses {
    align-items: center;
    gap: 8px;
    margin-top: 18px;
}

.status-badge {
    min-height: 30px;
    line-height: 1.3;
    white-space: normal;
}

.order-seller {
    padding-top: 12px;
    border-top: 1px solid #f0f0f0;
    line-height: 1.5;
}
