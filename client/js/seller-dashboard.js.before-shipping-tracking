document
    .querySelectorAll(".promotion-plan")
    .forEach(button => {

        button.addEventListener(
            "click",
            async () => {

                if (!selectedPromotionProduct) {
                    return;
                }

                const packageName =
                    button.dataset.package;

                const token =
                    localStorage.getItem("token");

                if (!token) {
                    window.location.href =
                        "/login.html";
                    return;
                }

                const message =
                    document.getElementById(
                        "promotionMessage"
                    );

                const paymentActions =
                    document.getElementById(
                        "promotionPaymentActions"
                    );

                const paymentStatus =
                    document.getElementById(
                        "promotionPaymentStatus"
                    );

                message.textContent =
                    "Creating promotion request...";

                if (paymentActions) {
                    paymentActions.classList.add(
                        "hidden"
                    );
                }

                if (paymentStatus) {
                    paymentStatus.textContent = "";
                }

                try {

                    const response =
                        await fetch(
                            "/api/promotions",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json",

                                    "Authorization":
                                        `Bearer ${token}`
                                },

                                body: JSON.stringify({
                                    productId:
                                        selectedPromotionProduct._id,

                                    package:
                                        packageName
                                })
                            }
                        );

                    const data =
                        await response.json();

                    if (!response.ok) {
                        throw new Error(
                            data.message ||
                            "Failed to create promotion"
                        );
                    }

                    selectedPromotionId =
                        data.promotion.id;

                    message.textContent =
                        `Promotion created: ${data.promotion.amount} ${data.promotion.currency}`;

                    if (paymentActions) {
                        paymentActions.classList.remove(
                            "hidden"
                        );
                    }

                    console.log(
                        "PROMOTION CREATED:",
                        data
                    );

                } catch (error) {

                    console.error(
                        "Promotion error:",
                        error
                    );

                    message.textContent =
                        error.message ||
                        "Could not create promotion";
                }
            }
        );

    });


