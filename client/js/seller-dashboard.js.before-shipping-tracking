const checkPromotionPaymentButton =
    document.getElementById(
        "checkPromotionPaymentButton"
    );

if (checkPromotionPaymentButton) {

    checkPromotionPaymentButton.addEventListener(
        "click",
        async () => {

            if (!selectedPromotionId) {
                return;
            }

            const token =
                localStorage.getItem("token");

            if (!token) {
                window.location.href =
                    "/login.html";
                return;
            }

            const paymentStatus =
                document.getElementById(
                    "promotionPaymentStatus"
                );

            paymentStatus.textContent =
                "Checking MTN MoMo payment status...";

            try {

                const response =
                    await fetch(
                        `/api/promotions/${selectedPromotionId}/payment-status`,
                        {
                            method: "GET",

                            headers: {
                                "Authorization":
                                    `Bearer ${token}`
                            }
                        }
                    );

                const data =
                    await response.json();

                if (!response.ok) {
                    throw new Error(
                        data.message ||
                        "Could not check payment status"
                    );
                }

                const payment =
                    data.payment;

                if (
                    payment.momoStatus ===
                    "SUCCESSFUL"
                ) {

                    paymentStatus.textContent =
                        "Payment successful! Your product promotion is now active.";

                    console.log(
                        "PROMOTION ACTIVATED:",
                        data
                    );

                    return;
                }

                if (
                    payment.momoStatus ===
                    "FAILED"
                ) {

                    paymentStatus.textContent =
                        "Payment failed. Please try again.";

                    return;
                }

                paymentStatus.textContent =
                    `Payment status: ${payment.momoStatus || "PENDING"}. Please approve the payment on your phone and check again.`;

            } catch (error) {

                console.error(
                    "Payment status error:",
                    error
                );

                paymentStatus.textContent =
                    error.message ||
                    "Could not check payment status";
            }
        }
    );

}

productForm.addEventListener(
    "submit",
    async event => {

        event.preventDefault();

        try {

            formMessage.textContent =
                "Uploading images...";


            const files =
                Array.from(productImages.files);

                const videoFile =
    productVideo.files[0];


            if (files.length > 10) {

                throw new Error(
                    "You can select up to 10 images."
                );
            }


            const imageUrls = [];

            let videoUrl = null;


            if (
    files.length > 0 ||
    videoFile
) {

    const uploadData =
        new FormData();


    files.forEach(file => {

        uploadData.append(
            "files",
            file
        );

    });


    if (videoFile) {

        uploadData.append(
            "files",
            videoFile
        );
    }


    const uploadResponse =
        await fetch(
            "/api/uploads",
            {
                method: "POST",

                headers: {
                    "Authorization":
                        "Bearer " + token
                },

                body: uploadData
            }
        );


    const uploadResult =
        await uploadResponse.json();


    if (!uploadResponse.ok) {

        throw new Error(
            uploadResult.message ||
            "File upload failed"
        );
    }


    uploadResult.files.forEach(
        file => {

            if (
                file.mimetype.startsWith(
                    "image/"
                )
            ) {

                imageUrls.push(
                    file.url
                );

            } else if (
                file.mimetype.startsWith(
                    "video/"
                )
            ) {

                videoUrl =
                    file.url;
            }

        }
    );
}

            formMessage.textContent =
                "Creating product...";


            const formData =
                new FormData(productForm);


            const product = {

                title:
                    formData
                        .get("title")
                        .trim(),

                description:
                    formData
                        .get("description")
                        .trim(),

                price:
                    Number(
                        formData.get("price")
                    ),

                currency:
                    formData.get("currency"),

                category:
                    formData.get("category"),

                location:
                    formData
                        .get("location")
                        .trim(),

                condition:
                    formData.get("condition"),

                stock:
                    Number(
                        formData.get("stock")
                    ),

                images:
                    imageUrls,

                    video:
                        videoUrl

                   
            };


            const response =
                await fetch(
                    "/api/products",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Authorization":
                                "Bearer " + token
                        },

                        body:
                            JSON.stringify(product)
                    }
                );


            const data =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    data.message ||
                    "Could not create product"
                );
            }


            formMessage.textContent =
                "Product published successfully.";


            productForm.reset();

            imagePreview.innerHTML = "";
            videoPreview.innerHTML = "";


            await loadMyProducts();


        } catch (error) {

            console.error(
                "Create product error:",
                error
            );


            formMessage.textContent =
                error.message;
        }
    }
);

productImages.addEventListener(
    "change",
    () => {

        imagePreview.innerHTML = "";

        const files =
            Array.from(productImages.files);

        if (files.length > 10) {

            formMessage.textContent =
                "You can select up to 10 images.";

            productImages.value = "";

            return;
        }

        formMessage.textContent = "";

        files.forEach(file => {

            if (!file.type.startsWith("image/")) {
                return;
            }

            const reader =
                new FileReader();

            reader.onload = (event) => {

                const image =
                    document.createElement("img");

                image.src =
                    event.target.result;

                image.alt =
                    file.name;

                imagePreview.appendChild(image);
            };

            reader.readAsDataURL(file);
        });
    }
);

async function loadSalesSummary() {
    try {
        const response = await fetch(
            "/api/orders/sales-summary",
            {
                headers: {
                    "Authorization": "Bearer " + token
                }
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message || "Failed to load sales summary"
            );
        }

        const summary = data.summary || {};

        const totalSalesElement =
            document.getElementById("totalSales");

        const totalCommissionElement =
            document.getElementById("totalCommission");

        const totalEarningsElement =
            document.getElementById("totalEarnings");

        const totalOrdersElement =
            document.getElementById("totalOrders");

        if (totalSalesElement) {
            totalSalesElement.textContent =
                `${formatPrice(summary.totalSales || 0)} RWF`;
        }

        if (totalCommissionElement) {
            totalCommissionElement.textContent =
                `${formatPrice(summary.totalCommission || 0)} RWF`;
        }

        if (totalEarningsElement) {
            totalEarningsElement.textContent =
                `${formatPrice(summary.totalEarnings || 0)} RWF`;
        }

        if (totalOrdersElement) {
            totalOrdersElement.textContent =
                Number(summary.totalOrders || 0);
        }

    } catch (error) {
        console.error(
            "Sales summary error:",
            error
        );
    }
}


async function updateSalesOrderStatus(orderId, nextStatus) {
    try {
        const response = await fetch(
            `/api/orders/${orderId}/status`,
            {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + token
                },
                body: JSON.stringify({
                    status: nextStatus
                })
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message ||
                "Failed to update order status"
            );
        }

        await loadSalesOrders();
        await loadSalesSummary();

    } catch (error) {
        console.error(
            "Update sales order status error:",
            error
        );

        alert(
            error.message ||
            "Failed to update order status"
        );
    }
}


function setupSalesOrderActions() {
    const container =
        document.getElementById("salesOrdersContainer");

    if (!container) {
        return;
    }

    container.addEventListener("click", async (event) => {

        const button =
            event.target.closest(
                ".sales-order-action-button"
            );

        if (!button) {
            return;
        }

        const orderId =
            button.dataset.orderId;

        const nextStatus =
            button.dataset.nextStatus;

        if (!orderId || !nextStatus) {
            return;
        }

        button.disabled = true;
        button.textContent = "Updating...";

        await updateSalesOrderStatus(
            orderId,
            nextStatus
        );
    });
}

async function loadSalesOrders() {
    try {
        const response = await fetch(
            "/api/orders/my-sales",
            {
                headers: {
                    "Authorization": "Bearer " + token
                }
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message || "Failed to load sales orders"
            );
        }

        const container =
            document.getElementById(
                "salesOrdersContainer"
            );

        const emptyState =
            document.getElementById(
                "salesOrdersEmpty"
            );

        if (!container) {
            return;
        }

        const orders = Array.isArray(data.orders)
            ? data.orders
            : [];

        if (orders.length === 0) {
            if (emptyState) {
                emptyState.classList.remove("hidden");
            }

            return;
        }

        if (emptyState) {
            emptyState.classList.add("hidden");
        }

        const ordersHtml = orders.map(order => {

            const product =
                order.product || {};

            const buyer =
                order.buyer || {};

            const buyerName =
                `${buyer.firstName || ""} ${buyer.lastName || ""}`.trim()
                || "Unknown buyer";

            const productTitle =
                product.title || "Unknown product";

            const currency =
                order.currency || "RWF";

            const orderDate =
                order.createdAt
                    ? new Date(
                        order.createdAt
                    ).toLocaleDateString()
                    : "-";

            return `
                <div class="sales-order-card">

                    <div class="sales-order-main">

                        <h3>
                            ${escapeHtml(productTitle)}
                        </h3>

                        <p>
                            Buyer:
                            <strong>
                                ${escapeHtml(buyerName)}
                            </strong>
                        </p>

                        <p>
                            Quantity:
                            <strong>
                                ${Number(order.quantity || 0)}
                            </strong>
                        </p>

                        <p>
                            Date:
                            <strong>
                                ${escapeHtml(orderDate)}
                            </strong>
                        </p>

                    </div>

                    <div class="sales-order-financial">

                        <p>
                            Total:
                            <strong>
                                ${formatPrice(
                                    order.totalAmount || 0
                                )} ${escapeHtml(currency)}
                            </strong>
                        </p>

                        <p>
                            Commission:
                            <strong>
                                ${formatPrice(
                                    order.commissionAmount || 0
                                )} ${escapeHtml(currency)}
                            </strong>
                        </p>

                        <p>
                            Your Earnings:
                            <strong>
                                ${formatPrice(
                                    order.sellerAmount || 0
                                )} ${escapeHtml(currency)}
                            </strong>
                        </p>

                    </div>

                    <div class="sales-order-status">

                        <span>
                            Payment:
                            ${escapeHtml(
                                order.paymentStatus || "pending"
                            )}
                        </span>

                        <span>
                            Order:
                            ${escapeHtml(
                                order.status || "pending"
                            )}
                        </span>

                        ${
                            order.status === "paid"
                                ? `
                                    <button
                                        type="button"
                                        class="sales-order-action-button"
                                        data-order-id="${escapeHtml(order._id)}"
                                        data-next-status="processing"
                                    >
                                        Start Processing
                                    </button>
                                `
                                : order.status === "processing"
                                    ? `
                                        <button
                                            type="button"
                                            class="sales-order-action-button"
                                            data-order-id="${escapeHtml(order._id)}"
                                            data-next-status="completed"
                                        >
                                            Mark as Completed
                                        </button>
                                    `
                                    : order.status === "completed"
                                        ? `
                                            <span class="sales-order-completed">
                                                ✓ Completed
                                            </span>
                                        `
                                        : ""
                        }

                    </div>

                </div>
            `;
        }).join("");

        container.innerHTML = ordersHtml;

    } catch (error) {
        console.error(
            "Sales orders error:",
            error
        );
    }
}


function formatPrice(price) {

    return new Intl.NumberFormat(
        "en-RW"
    ).format(Number(price || 0));
}

productVideo.addEventListener(
    "change",
    () => {

        videoPreview.innerHTML = "";

        const file =
            productVideo.files[0];

        if (!file) {
            return;
        }


        if (!file.type.startsWith("video/")) {

            formMessage.textContent =
                "Please select a video file.";

            productVideo.value = "";

            return;
        }


        if (file.size > 100 * 1024 * 1024) {

            formMessage.textContent =
                "Video must be smaller than 100 MB.";

            productVideo.value = "";

            return;
        }


        formMessage.textContent = "";


        const video =
            document.createElement("video");

        video.controls = true;

        video.preload = "metadata";

        video.src =
            URL.createObjectURL(file);

        videoPreview.appendChild(video);
