        console.log(
            "Loading messages for:",
            conversationId
        );

        const data =
            await apiRequest(
                `/messages/${conversationId}`
            );

        if (!data) return;

        console.log(
    "Messages response:",
    JSON.stringify(data, null, 2)
);
        messagesContainer.innerHTML = "";

        const messages =
            data.messages || [];

        if (messages.length === 0) {

            messagesContainer.innerHTML =
                "<p>No messages yet.</p>";

            return;
        }

        messages.forEach(
            (message) => {

                addMessageToUI(
                    message
                );
            }
        );

        scrollMessages();

    } catch (error) {

        console.error(
            "Load messages error:",
            error
        );

        messagesContainer.innerHTML =
            "<p>Failed to load messages.</p>";
    }
}


