// ===============================
// API REQUEST
// ===============================

async function apiRequest(url, options = {}) {

    const response = await fetch(
        `${API}${url}`,
        {
            ...options,

            headers: {
                "Content-Type": "application/json",

                "Authorization":
                    `Bearer ${token}`,

                ...(options.headers || {})
            }
        }
    );

    const data = await response.json();

    if (response.status === 401) {
        logout();
        return null;
    }

    if (!response.ok) {
        throw new Error(
            data.message || "Request failed"
        );
    }

    return data;
}


