// ===============================
// SOCKET.IO
// ===============================

function connectSocket() {

    socket = io(
        "http://localhost:3000",
        {
            auth: {
                token
            }
        }
    );


    socket.on("connect", () => {

        console.log(
            "Socket connected:",
            socket.id
        );


       if (currentConversationId) {

    console.log(
        "JOINING ROOM:",
        currentConversationId
    );

    socket.emit(
        "joinConversation",
        currentConversationId
    );
        }
    });


    socket.on(
        "connect_error",
        (error) => {

            console.error(
                "Socket connection error:",
                error.message
            );
        }
    );


    // ===============================
    // INCOMING CALL
    // ===============================

    socket.on(
        "incomingCall",
        async (data) => {

            console.log(
                "Incoming call:",
                data
            );

            if (
                !data ||
                !data.offer ||
                !data.callerId
            ) {
                console.error(
                    "Invalid incoming call data"
                );

                return;
            }

            currentCallType =
                data.callType || "audio";

            currentCallUserId =
                String(data.callerId);

            currentConversationId =
                data.conversationId || null;

            callContainer.classList.remove(
                "hidden"
            );

            callStatus.innerText =
                "Incoming call...";

            const accepted =
                confirm(
                    "Incoming " +
                    currentCallType +
                    " call. Accept?"
                );

            if (!accepted) {

                socket.emit(
                    "rejectCall",
                    {
                        callerSocketId:
                            data.callId
                    }
                );

                callContainer.classList.add(
                    "hidden"
                );

                return;
            }

            try {

                localStream =
                    await getAudioStream();

                if (!localStream) {
                    return;
                }

                peerConnection =
                    createPeerConnection();

                localStream
                    .getTracks()
                    .forEach(
                        (track) => {

                            peerConnection.addTrack(
                                track,
                                localStream
                            );

                        }
                    );

                await peerConnection.setRemoteDescription(
                    new RTCSessionDescription(
                        data.offer
                    )
                );

                const answer =
                    await peerConnection.createAnswer();

                await peerConnection.setLocalDescription(
                    answer
                );

                socket.emit(
                    "acceptCall",
                    {
                        callerSocketId:
                            data.callId,

                        answer
                    }
                );

                callStatus.innerText =
                    "Call connected";

            } catch (error) {

                console.error(
                    "Accept call error:",
                    error
                );

                callStatus.innerText =
                    "Call failed";

                socket.emit(
                    "rejectCall",
                    {
                        callerSocketId:
                            data.callId
                    }
                );
            }
        }
    );


    socket.on(
        "newMessage",
     (message) => {

            console.log(
                "New message:",
                message
            );


            if (!message) {
                return;
            }


            /*
             * Normalize conversation ID.
             *
             * Depending on the server response,
             * message.conversation can be:
             *
             * "conversationId"
             *
             * OR
             *
             * {
             *     _id: "conversationId"
             * }
             */

            const messageConversationId =
                String(
                    message.conversation?._id ||
                    message.conversation?.id ||
                    message.conversation
                );


            /*
             * If this message belongs to the
             * conversation currently open,
             * add it to the chat window.
             */

            if (
                messageConversationId ===
                String(currentConversationId)
            ) {

                addMessageToUI(
                    message
                );

                scrollMessages();
            }


            /*
             * Update sidebar immediately.
             */

            updateConversationFromMessage(
                message,
                messageConversationId
            );
        }
    );


    socket.on(
        "messageError",
        (error) => {

            console.error(
                "Socket message error:",
                error
            );

            alert(
                error.message ||
                "Message error"
            );
        }
    );
}


// ===============================
// UPDATE CONVERSATION FROM MESSAGE
// ===============================

function updateConversationFromMessage(message, conversationId) {
    const id = String(conversationId);

    const index = conversationsCache.findIndex(
        conversation => String(conversation._id) === id
    );

    if (index === -1) {
        loadConversations();
        return;
    }

    const conversation = conversationsCache[index];

    conversation.lastMessage = message;
    conversation.updatedAt =
        message.createdAt || new Date().toISOString();

    // Remove old position
    conversationsCache.splice(index, 1);

    // Put updated conversation at the top
    conversationsCache.unshift(conversation);

    // Render directly from cache
    renderConversationsFromCache();
}

function renderConversationsFromCache() {
    renderConversations({
        conversations: conversationsCache
    });
}

