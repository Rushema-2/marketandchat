const API = "http://localhost:3000/api";

const token = localStorage.getItem("token");
const currentUser = JSON.parse(
    localStorage.getItem("user") || "null"
);

let socket = null;
let currentConversationId = null;
let myContacts = [];


// ===============================
// AUTH CHECK
// ===============================

if (!token || !currentUser) {
    window.location.href = "login.html";
}


// ===============================
// DOM
// ===============================
const userSearchInput =
    document.getElementById("userSearchInput");

const searchResults =
    document.getElementById("searchResults");
const userInfo =
    document.getElementById("userInfo");

const conversationList =
    document.getElementById("conversationList");

    const contactList =
    document.getElementById("contactList");

const messagesContainer =
    document.getElementById("messages");

const chatTitle =
    document.getElementById("chatTitle");

const messageForm =
    document.getElementById("messageForm");

const messageInput =
    document.getElementById("messageInput");

const logoutBtn =
    document.getElementById("logoutBtn");
// ===============================
// API REQUEST
// ===============================

async function apiRequest(url, options = {}) {

    const response = await fetch(
        `${API}${url}`,
        {
            ...options,

            headers: {
                "Content-Type": "application/json",

                "Authorization":
                    `Bearer ${token}`,

                ...(options.headers || {})
            }
        }
    );

    const data = await response.json();

    if (response.status === 401) {
        logout();
        return null;
    }

    if (!response.ok) {
        throw new Error(
            data.message || "Request failed"
        );
    }

    return data;
}

// ===============================
// USER INFO
// ===============================

if (currentUser && userInfo) {
    userInfo.innerText =
        `${currentUser.firstName} ${currentUser.lastName}`;
}


// ===============================
// SOCKET.IO
// ===============================

function connectSocket() {

    socket = io(
        "http://localhost:3000",
        {
            auth: {
                token
            }
        }
    );

    socket.on("connect", () => {

        console.log(
            "Socket connected:",
            socket.id
        );

        if (currentConversationId) {
        console.log("JOINING ROOM:", conversationId);
            socket.emit(
                "joinConversation",
                currentConversationId
            );
        }
    });

    socket.on("connect_error", (error) => {

        console.error(
            "Socket connection error:",
            error.message
        );
    });

    socket.on("newMessage", (message) => {

        console.log(
            "New message:",
            message
        );

        const messageConversationId =
            String(
                message.conversation?._id ||
                message.conversation
            );

       if (
    message.conversation === currentConversationId
) {
    addMessageToUI(message);
}

loadConversations();
    });

    socket.on("messageError", (error) => {

        console.error(
            "Socket message error:",
            error
        );

        alert(error.message);
    });
}






async function loadContacts() {

    try {

        const contacts =
            await apiRequest("/contacts");

        myContacts =
            contacts.map(
                item => String(item.contact._id)
            );

        console.log(
            "My contacts:",
            myContacts
        );

    } catch(error) {

        console.error(
            "Load contacts error:",
            error
        );

    }
}
// ===============================
// USER SEARCH
// ===============================

if (userSearchInput) {

    userSearchInput.addEventListener(
        "input",
        async () => {

            const q =
                userSearchInput.value.trim();

            if (q.length < 2) {
                searchResults.innerHTML = "";
                return;
            }


            try {

                const users =
                    await apiRequest(
                        `/users/search?q=${q}`
                    );


                searchResults.innerHTML = "";


                users.forEach(
                    (user) => {

                        const div =
                            document.createElement("div");

                        div.className =
                            "search-user";


                        div.innerHTML = `
                            <span>
                                ${user.firstName}
                                ${user.lastName}
                            </span>

                            <button>
    ${
        myContacts.includes(String(user._id))
        ? "Chat"
        : "Add"
    }
</button>
                        `;


                       const button =
    div.querySelector("button");


button.addEventListener(
    "click",
    async () => {

        if (
            myContacts.includes(
                String(user._id)
            )
        ) {

            // Already contact -> open chat
            await openContact(
                user._id
            );

        } else {

            // New contact -> add first
            await addContact(
                user._id
            );

            await loadContacts();

            await openContact(
                user._id
            );

        }

    }
);


                        searchResults.appendChild(div);

                    }
                );


            } catch(error) {

                console.error(
                    "Search error:",
                    error
                );

            }

        }
    );

}





// ===============================
// ADD CONTACT
// ===============================

async function addContact(userId) {

    try {

        const result =
            await apiRequest(
                "/contacts/add",
                {
                    method:"POST",

                    body: JSON.stringify({
                        contactId:userId
                    })
                }
            );


        alert(
            "Contact added"
        );


        searchResults.innerHTML = "";


        userSearchInput.value = "";


    } catch(error) {

        alert(
            error.message
        );

    }

}


// ===============================
// LOAD CONVERSATIONS
// ===============================

async function loadConversations() {

    try {

        const data =
            await apiRequest(
                "/conversations"
            );

        if (!data) return;

        console.log(
            "Conversations:",
            data
        );
        console.log(
    "RAW JSON:",
    JSON.stringify(data, null, 2)
);
        window.__CONVERSATIONS__ = data;

        renderConversations(data);

    } catch (error) {

        console.error(
            "Load conversations error:",
            error
        );

        conversationList.innerHTML =
            "<p>Failed to load conversations.</p>";
    }
}


// ===============================
// RENDER CONVERSATIONS
// ===============================

function renderConversations(data) {

    conversationList.innerHTML = "";

    const conversations =
        data.conversations || data;

    if (
        !Array.isArray(conversations) ||
        conversations.length === 0
    ) {
        conversationList.innerHTML =
            "<p>No conversations found.</p>";

        return;
    }

    conversations.forEach(
        (conversation) => {

            const div =
                document.createElement("div");

            div.className =
                "conversation";

            /*
             * Show only the latest message.
             * Do NOT show participant name or email.
             */

if (conversation.lastMessage) {

    div.innerText =
        conversation.lastMessage.text;

} else {

    div.innerText =
        "No messages yet.";

}

div.addEventListener(
    "click",
    () => {
        openConversation(
            conversation
        );
    }
);

conversationList.appendChild(div);
        }
    );
}

// ===============================
// FIND OTHER PARTICIPANT
// ===============================

function getOtherParticipant(conversation) {

    if (
        !conversation.participants ||
        !Array.isArray(conversation.participants)
    ) {
        return null;
    }

    return conversation.participants.find(
        (participant) => {

            const id = String(
                participant._id ||
                participant.id
            );

            return id !==
                String(currentUser.id);
        }
    );
}


// ===============================
// OPEN CONVERSATION
// ===============================

async function openConversation(
    conversation
) {

    const conversationId =
        String(conversation._id);

    console.log(
        "Opening conversation:",
        conversationId
    );

    if (
        socket &&
        currentConversationId
    ) {
        socket.emit(
            "leaveConversation",
            currentConversationId
        );
    }

    currentConversationId =
        conversationId;

    const otherUser =
        getOtherParticipant(
            conversation
        );

    if (otherUser) {

        chatTitle.innerText =
            `${otherUser.firstName} ${otherUser.lastName}`;

    } else {

        chatTitle.innerText =
            "Conversation";
    }

    messagesContainer.innerHTML =
        "<p>Loading messages...</p>";

    if (socket && socket.connected) {

        socket.emit(
            "joinConversation",
            conversationId
        );
    }

    await loadMessages(
        conversationId
    );
}

// ===============================
// OPEN CONTACT
// CREATE OR GET CONVERSATION
// ===============================

async function openContact(userId) {

    try {

        console.log(
            "Creating/opening conversation with:",
            userId
        );

        const result =
            await apiRequest(
                "/conversations",
                {
                    method: "POST",

                    body: JSON.stringify({
                        userId: userId
                    })
                }
            );

        if (!result || !result.conversation) {

            throw new Error(
                "Conversation was not returned by server"
            );
        }

        console.log(
            "Conversation:",
            result.conversation
        );

        await loadConversations();

        await openConversation(
            result.conversation
        );

    } catch (error) {

        console.error(
            "Open contact error:",
            error
        );

        alert(
            error.message ||
            "Could not open conversation"
        );
    }
}


// ===============================
// LOAD MESSAGES
// ===============================

async function loadMessages(
    conversationId
) {

    try {

        console.log(
            "Loading messages for:",
            conversationId
        );

        const data =
            await apiRequest(
                `/messages/${conversationId}`
            );

        if (!data) return;

        console.log(
    "Messages response:",
    JSON.stringify(data, null, 2)
);
        messagesContainer.innerHTML = "";

        const messages =
            data.messages || [];

        if (messages.length === 0) {

            messagesContainer.innerHTML =
                "<p>No messages yet.</p>";

            return;
        }

        messages.forEach(
            (message) => {

                addMessageToUI(
                    message
                );
            }
        );

        scrollMessages();

    } catch (error) {

        console.error(
            "Load messages error:",
            error
        );

        messagesContainer.innerHTML =
            "<p>Failed to load messages.</p>";
    }
}


// ===============================
// ADD MESSAGE TO UI
// ===============================

function addMessageToUI(message) {
console.log("ADDING MESSAGE TO UI:", message.text);
    if (!message || !message._id) {
        return;
    }

    const existing =
        document.querySelector(
            `[data-message-id="${message._id}"]`
        );

    if (existing) {
        return;
    }

    const div =
        document.createElement("div");

    div.className =
        "message";

    div.dataset.messageId =
        message._id;

    const sender =
        message.sender;

    const senderId =
        String(
            sender?._id ||
            sender?.id ||
            message.sender
        );

    if (
        senderId ===
        String(currentUser.id)
    ) {
        div.classList.add("mine");
    }

    const senderName =
        sender
            ? `${sender.firstName} ${sender.lastName}`
            : "User";

    div.innerHTML = `
        <div class="message-name">
            ${escapeHtml(senderName)}
        </div>

        <div>
            ${escapeHtml(message.text || "")}
        </div>
    `;

    messagesContainer.appendChild(div);

    scrollMessages();
}


// ===============================
// SEND MESSAGE
// ===============================

messageForm.addEventListener(
    "submit",
    (event) => {

        event.preventDefault();

        const text =
            messageInput.value.trim();

        if (!currentConversationId) {

            alert(
                "Select a conversation first."
            );

            return;
        }

        if (!text) {
            return;
        }

        if (
            !socket ||
            !socket.connected
        ) {

            alert(
                "Socket is not connected."
            );

            return;
        }

        socket.emit(
            "sendMessage",
            {
                conversationId:
                    currentConversationId,

                text
            }
        );

        messageInput.value = "";
        messageInput.focus();
    }
);


// ===============================
// LOGOUT
// ===============================

function logout() {

    if (socket) {
        socket.disconnect();
    }

    localStorage.removeItem("token");
    localStorage.removeItem("user");

    window.location.href =
        "login.html";
}


logoutBtn.addEventListener(
    "click",
    logout
);



// ===============================
// HTML ESCAPE
// ===============================

function escapeHtml(text) {

    const div =
        document.createElement("div");

    div.textContent =
        String(text);

    return div.innerHTML;
}


// ===============================
// SCROLL
// ===============================

function scrollMessages() {

    messagesContainer.scrollTop =
        messagesContainer.scrollHeight;
}


// ===============================
// START
// ===============================

connectSocket();

loadContacts();

loadConversations();


